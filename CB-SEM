# CFA MODEL (OARC stats, 2025; Lavaan.org, 2025)
model_structural <- 'Satisfaction =~ WAITI + SPEED + SEATS + TIME + COST + CONNE + PUNCT + CLEAN + FREQU
Viability =~ CONGE + PARKI + CRIMI
Accessibility =~ HEALT + SECUR + ADMIN + FOOD + MARKE + MEDIC + COMMU
Administration =~ TRUS3 + TRUS1 + TRUS2
Health =~ HAPPI + RELAX + SADNE + AGITA + DESPO
Satisfaction ~ Administration + Health + Accessibility + Viability + SEX + AGE + EDU '

fit_multi <- sem(
  model_structural,
  data = cfa_sample,
  group = "REG",
  estimator = "WLSMV",
  missing = "listwise")

summary(fit_multi, standardized=TRUE, fit.measures=TRUE)
fitMeasures(fit_multi)

library(psych)
library(dplyr)
library(tibble)



