invert_then_normalize <- function(x) {
  if (all(is.na(x))) return(rep(NA, length(x)))
  inv_x <- max(x, na.rm = TRUE) - x
  rng <- range(inv_x, na.rm = TRUE)
  (inv_x - rng[1]) / diff(rng)
}

