frequency_table <- function(data, var) {
  
  x <- data[[var]]
  
  valid_n <- sum(!is.na(x))
  
  missing_n <- sum(is.na(x))
  
  missing_pct <- round(
    (missing_n / length(x)) * 100,
    2
  )
  
  valid_table <- as.data.frame(
    table(x, useNA = "no")
  )
  
  names(valid_table) <- c("Category", "Frequency")  
  valid_table %>%
    mutate(
      Variable = var,
      Percentage = round(
        (Frequency / valid_n) * 100,
        2
      ),
      Missing_n = missing_n
    ) %>%
    dplyr::select(
      Variable,
      Category,
      Frequency,
      Percentage,
      Missing_n
    )
}



