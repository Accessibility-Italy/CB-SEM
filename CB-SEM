invert_then_normalize <- function(x, min_val = 1, max_val = 5) {
  if (all(is.na(x))) return(rep(NA, length(x)))
  
  x_inv <- max_val + min_val - x
  
  (x_inv - min(x_inv, na.rm = TRUE)) / (max(x_inv, na.rm = TRUE) - min(x_inv, na.rm = TRUE))
}

