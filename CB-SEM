# FORNELL-LARCKER (Wilhelm, 2022)

source("https://raw.githubusercontent.com/franciscowilhelm/r-collection/master/forn_larcker_test.R")


factors <- c("Perceived_accessibility", "Viability", "Accessibility", 
             "Administration", "Affordability", "health")

compare <- function(factor_name, all_factors, fit) {
  others <- setdiff(all_factors, factor_name)
  forn_larcker_test(
    fit,
    x = factor_name,
    y = others,
    x.only = TRUE
  )
}

forn_larcker_all <- map_dfr(factors, compare, all_factors = factors, fit = fit_measurement)

print(forn_larcker_all, n = Inf)


#VIF (Bhale and Harpreet, 2024)

vars <- c(vars <- c("WAITING", "SPEED", "SEATS", "TIME", "COST", "PUNCTUALITY", "CLEAN", "CONNECTION", "CONGESTION", "PARKING", "TRUST3", "TRUST1", "TRUST2", "AFFORDABILITY1", "AFFORDABILITY2", 
                    "HAPPINESS" ,"RELAX" , "SADNESS" , "AGITATION" , "DESPONDENCY" , "HEALTH" , "SECURITY" , "ADMINISTRATION" , "FOOD" )
)

calc_all_vif <- function(data, variables) {
  vif_results <- numeric(length(variables))
  names(vif_results) <- variables
  
  for (var in variables) {
    predictors <- setdiff(variables, var)
    formula <- as.formula(paste(var, "~", paste(predictors, collapse = " + ")))
    lm_model <- lm(formula, data = data)
    
    
    r2 <- summary(lm_model)$r.squared
    
    
    vif_results[var] <- 1 / (1 - r2)
  }
  
  return(vif_results)
}

vif_all <- calc_all_vif(cfa_sample, vars)
print(vif_all)


# SEM MODEL (OARC stats, 2025; Lavaan.org, 2025)

model_new <- '
  Perceived_accessibility =~ WAITING + SPEED + SEATS + TIME + COST + PUNCTUALITY + CLEAN + CONNECTION
  Viability =~ CONGESTION + PARKING
  Accessibility =~ HEALTH + SECURITY + ADMINISTRATION + FOOD
  Administration =~ TRUST3 + TRUST1 + TRUST2
  Affordability =~ AFFORDABILITY1 + AFFORDABILITY2
  health =~ HAPPINESS + RELAX + SADNESS + AGITATION + DESPONDENCY
 Perceived_accessibility ~ Administration + health + Accessibility + Affordability + Viability
'

fit <- sem(model_new, data = cfa_sample, missing = "fiml")

summary(fit, standardized = TRUE, fit.measures = TRUE)

fitMeasures(fit)

# Plot (Lishinski, 2024)
lavaanPlot(model = fit,
           node_options = list(shape = "box", fontname = "Helvetica", fontsize = 14),
           edge_options = list(color = "black", lty = 1, lwd = 1.5),
           coefs = TRUE,     
           stand = FALSE)   


#R-Squared (RDRR.IO, na)
r2_values <- inspect(fit, "r2")
print(r2_values)

#other measures (STATISTIKA, 2025)

cfi <- fitMeasures(fit, "cfi")
df_model <- fitMeasures(fit, "df")
df_baseline <- fitMeasures(fit, "baseline.df")
print(cfi)
print(df_model)
print(df_baseline)

pcfi <- cfi * (df_model / df_baseline)
pcfi


