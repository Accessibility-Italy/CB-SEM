#VIF (Bhale and Harpreet, 2024)
variables2 <- c(variables2 <- c("CRIMI", "WAITI","SPEED", "SEATS","TIME","COST","PUNCT","CLEAN","CONNE", "FREQU",
                                "CONGE","PARKI","TRUS3", "TRUS1","TRUS2",
                                "RELAX","SADNE","AGITA","DESPO","HAPPI",
                                "HEALT","SECUR","ADMIN","FOOD", "MEDIC", "COMMU", "MARKE")
)
calc_all_vif <- function(data, variables2) {
  vif_results <- numeric(length(variables2))
  names(vif_results) <- variables2
  
  for (var in variables2) {
    predictors <- setdiff(variables2, var)
    formula <- as.formula(paste(var, "~", paste(predictors, collapse = " + ")))
    lm_model <- lm(formula, data = data)
    
    
    r2 <- summary(lm_model)$r.squared
    
    
    vif_results[var] <- 1 / (1 - r2)
  }
  
  return(vif_results)
}


